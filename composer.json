{
    "name": "roflsunriz/php-uploader",

    "description": "Simple PHP file uploader with download/delete authentication",

    "type": "project",
    "keywords": ["php", "uploader", "file-sharing"],
    "license": "MIT",
    "authors": [
        {
            "name": "roflsunriz"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-sqlite3": "*",
        "ext-openssl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "classmap": [
            "backend/models/"
        ]
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "lint": "@php vendor/bin/phpcs",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "check-syntax": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "test": [
            "php infrastructure/scripts/test-browser-title.php",
            "php infrastructure/scripts/test-folder-file-counts.php",
            "php infrastructure/scripts/test-version.php",
            "php infrastructure/scripts/test-upload-form.php"
        ],
        "release": "php infrastructure/scripts/release.php"
    }
}
